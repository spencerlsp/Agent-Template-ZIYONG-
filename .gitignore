.pytest_cache/
.pytest-tmp/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- Editors / OS ------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# --- Local scratch -----------------------------------------------------
scratch/

