# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored; `.env.example` is not. Never put real keys in here.
# ---------------------------------------------------------------------------

# --- LLM -------------------------------------------------------------------
# "openai_compat" = any OpenAI-compatible endpoint, "mock" = offline, no key.
AGENT_LLM_PROVIDER=openai_compat
AGENT_LLM_MODEL=deepseek-chat
AGENT_LLM_BASE_URL=https://api.deepseek.com/v1
AGENT_LLM_API_KEY=
AGENT_LLM_TEMPERATURE=0.2
AGENT_LLM_MAX_TOKENS=1024
AGENT_LLM_TIMEOUT_S=60

# Other providers that work with the same adapter:
#   OpenAI : AGENT_LLM_MODEL=gpt-4o-mini
#            AGENT_LLM_BASE_URL=https://api.openai.com/v1
#   Ollama : AGENT_LLM_MODEL=qwen2.5:7b
#            AGENT_LLM_BASE_URL=http://localhost:11434/v1

# --- Agent loop ------------------------------------------------------------
AGENT_MAX_STEPS=8
# Leave empty to use the built-in system prompt.
AGENT_SYSTEM_PROMPT=

# --- RAG -------------------------------------------------------------------
AGENT_EMBEDDING_PROVIDER=local_hash
# AGENT_EMBEDDING_PROVIDER=openai_compat
# AGENT_EMBEDDING_MODEL=text-embedding-3-small
# AGENT_EMBEDDING_BASE_URL=https://api.openai.com/v1
# AGENT_EMBEDDING_API_KEY=
AGENT_CHUNK_SIZE=500
AGENT_CHUNK_OVERLAP=80
AGENT_RAG_TOP_K=4

# --- MCP -------------------------------------------------------------------
# JSON array of stdio servers. The default points at the example server that
# ships with this template, so MCP works with no external dependencies.
AGENT_MCP_SERVERS=[{"name":"example","command":"python","args":["-m","agent_template.mcp.example_server"]}]